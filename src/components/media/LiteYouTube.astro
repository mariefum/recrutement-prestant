---
interface Props {
  id?: string;
  title: string;
  class?: string;
  /** Format vertical 9:16 (Shorts) */
  vertical?: boolean;
  /** Lecture automatique (muette) au chargement, sans clic */
  autoplay?: boolean;
}
const { id, title, class: extra = '', vertical = false, autoplay = false } = Astro.props;
const ratio = vertical ? 'aspect-[9/16]' : 'aspect-video';
// Vignette haute résolution ; repli vers hqdefault si maxres indisponible.
const thumb = id ? `https://i.ytimg.com/vi/${id}/maxresdefault.jpg` : null;
const thumbFallback = id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : null;
---
{id && autoplay ? (
  <div class={`relative w-full ${ratio} overflow-hidden rounded-sm bg-encre ${extra}`}>
    <iframe
      class="absolute inset-0 h-full w-full"
      src={`https://www.youtube-nocookie.com/embed/${id}?autoplay=1&mute=1&rel=0&playsinline=1`}
      title={title}
      loading="eager"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
) : id ? (
  <lite-yt
    class={`group relative block w-full ${ratio} overflow-hidden rounded-sm bg-encre cursor-pointer ${extra}`}
    data-id={id}
    role="button"
    tabindex="0"
    aria-label={`Lire la vidéo : ${title}`}
  >
    <img
      src={thumb}
      data-fallback={thumbFallback}
      alt={`Vidéo : ${title}`}
      loading="lazy"
      width="1280" height="720"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-soft group-hover:scale-105"
    />
    <span class="absolute inset-0 bg-encre/20 transition-colors duration-300 group-hover:bg-encre/10"></span>
    <span class="absolute inset-0 flex items-center justify-center">
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-blanc/90 backdrop-blur-sm transition-transform duration-300 ease-soft group-hover:scale-110">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="#14323C" aria-hidden="true" class="ml-1"><path d="M8 5v14l11-7z"/></svg>
      </span>
    </span>
  </lite-yt>
) : (
  <div class={`relative flex w-full ${ratio} items-center justify-center rounded-sm bg-creme border border-pierre-200 ${extra}`}>
    <div class="text-center px-6">
      <span class="flex h-14 w-14 mx-auto items-center justify-center rounded-full bg-blanc shadow-sm">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#A67C52" aria-hidden="true" class="ml-1"><path d="M8 5v14l11-7z"/></svg>
      </span>
      <p class="mt-4 text-xs uppercase tracking-widest text-pierre-500">Vidéo à venir</p>
    </div>
  </div>
)}

<script>
  // Repli de vignette : certaines vidéos n'ont pas de maxresdefault.
  document.querySelectorAll('lite-yt img[data-fallback]').forEach((img) => {
    img.addEventListener('error', function handle() {
      const el = this as HTMLImageElement;
      const fb = el.dataset.fallback;
      if (fb && el.src !== fb) { el.src = fb; }
      el.removeEventListener('error', handle);
    });
  });

  // Custom element : remplace la vignette par l'iframe YouTube au clic.
  class LiteYt extends HTMLElement {
    connectedCallback() {
      const activate = () => {
        const id = this.dataset.id;
        if (!id || this.querySelector('iframe')) return;
        const iframe = document.createElement('iframe');
        iframe.width = '560';
        iframe.height = '315';
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = this.getAttribute('aria-label') || 'Vidéo';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 h-full w-full';
        iframe.loading = 'lazy';
        this.innerHTML = '';
        this.appendChild(iframe);
      };
      this.addEventListener('click', activate);
      this.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
      });
    }
  }
  if (!customElements.get('lite-yt')) customElements.define('lite-yt', LiteYt);
</script>

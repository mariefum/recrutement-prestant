---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Faq from '../components/blocks/Faq.astro';
import CtaContact from '../components/blocks/CtaContact.astro';
import Button from '../components/ui/Button.astro';
import { faqSchema, breadcrumbSchema } from '../data/schema';

// Modèle de commissionnement Prestant (% des honoraires HT encaissés).
// Système de paliers : les taux d'entrée augmentent au-delà de 100 000 € HT de CA.
const paliers = [
  {
    titre: 'Jusqu’à 100 000 € HT de CA',
    sous: 'Votre rémunération de départ',
    highlight: false,
    lignes: [
      { type: 'Mandat simple', entree: '30 %', total: '50 %' },
      { type: 'Mandat exclusif', entree: '40 %', total: '60 %' },
    ],
  },
  {
    titre: 'Au-delà de 100 000 € HT',
    sous: 'Revenus boostés 🚀',
    highlight: true,
    lignes: [
      { type: 'Mandat simple', entree: '40 %', total: '60 %' },
      { type: 'Mandat exclusif', entree: '50 %', total: '70 %' },
    ],
  },
];

// Exemple sur une vente générant 40 000 € HT d'honoraires d'agence.
const exemples = [
  { titre: 'Mandat exclusif rentré et vendu', detail: '40 % (entrée) + 20 % (vente) = 60 %', commission: '24 000 €' },
  { titre: 'Le même, une fois 100 000 € atteints 🚀', detail: '50 % (entrée) + 20 % (vente) = 70 %', commission: '28 000 €' },
  { titre: 'Vente du mandat d’un collègue', detail: '20 % (vente)', commission: '8 000 €' },
];

const faq = [
  { question: 'Comment suis-je rémunéré ?', reponse: "Vous percevez un pourcentage des honoraires HT encaissés, à l'entrée du mandat et à la vente. À l'entrée : 30 % pour un mandat simple, 40 % pour un mandat exclusif. À la vente (sortie) : 20 %. Entrée et vente se cumulent : rentrer un mandat exclusif et le vendre vous-même représente 60 % des honoraires. Ces taux concernent les agents hors agence physique, c'est-à-dire hors bureaux de Biarritz et de Bordeaux." },
  { question: "Qu'est-ce que les « revenus boostés » au-delà de 100 000 € ?", reponse: "Une fois 100 000 € HT de chiffre d'affaires atteints sur l'exercice, vos taux d'entrée augmentent : 40 % pour un mandat simple et 50 % pour un mandat exclusif (la sortie reste à 20 %). Vos totaux passent ainsi à 60 % et 70 %." },
  { question: 'Comment fonctionne la cooptation ?', reponse: "Pour chaque agent qui rejoint l'équipe via votre réseau, vous touchez 5 % sur ses 3 premières ventes (sur les honoraires HT encaissés, déduction faite des éventuels apports d'affaires), dans la limite d'un forfait de 3 000 € TTC par vente." },
  { question: 'Y a-t-il un plafond de rémunération ?', reponse: "Non. Au statut d'agent commercial indépendant, vos revenus ne sont pas plafonnés : ils dépendent du nombre de mandats que vous rentrez et vendez, et de votre montée en puissance." },
];

const breadcrumb = breadcrumbSchema([
  { nom: 'Accueil', url: '/' },
  { nom: 'Rémunération', url: '/remuneration' },
]);
---
<BaseLayout
  title="Rémunération d'un agent commercial immobilier indépendant"
  description="Rémunération d'un agent commercial indépendant Prestant : 30 à 50 % à l'entrée du mandat selon paliers, 20 % à la vente et cooptation. Sans plafond."
  ogImage="og-remuneration.jpg"
  schemas={[faqSchema(faq), breadcrumb]}
>
  <Section bg="sable" spacing="md" class="pt-32 sm:pt-36">
    <nav aria-label="Fil d'Ariane" class="text-xs tracking-wide text-pierre-500 mb-8">
      <a href="/" class="hover:text-bronze">Accueil</a> <span class="mx-2">/</span> <span class="text-encre">Rémunération</span>
    </nav>
    <SectionHeading
      as="h1"
      eyebrow="Rémunération"
      title="Une rémunération transparente et non plafonnée"
      intro="Vous êtes rémunéré de l'entrée du mandat à la vente, avec des taux qui augmentent une fois 100 000 € HT de CA atteints. S'y ajoute la cooptation."
    />
  </Section>

  <!-- Le principe : commissions par palier -->
  <Section bg="blanc" spacing="lg">
    <SectionHeading eyebrow="Le commissionnement" title="Des taux qui progressent avec votre performance" />
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {paliers.map((p, i) => (
        <div
          class:list={[
            'rounded-sm p-8 border',
            p.highlight ? 'bg-encre border-bronze/40 text-blanc' : 'bg-sable border-transparent',
          ]}
          data-reveal style={`transition-delay:${i * 80}ms`}
        >
          <p class:list={['text-xs uppercase tracking-widest', p.highlight ? 'text-bronze-light' : 'text-bronze']}>{p.sous}</p>
          <h3 class:list={['mt-2 text-xl font-light', p.highlight ? 'text-blanc' : 'text-encre']}>{p.titre}</h3>
          <div class:list={['filet my-6', p.highlight ? 'bg-bronze-light/70' : '']}></div>
          <div class="space-y-5">
            {p.lignes.map((l) => (
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class:list={['text-sm font-medium', p.highlight ? 'text-blanc' : 'text-encre']}>{l.type}</p>
                  <p class:list={['text-xs font-light mt-0.5', p.highlight ? 'text-pierre-200' : 'text-pierre-500']}>
                    {l.entree} à l'entrée + 20 % à la vente
                  </p>
                </div>
                <p class:list={['display text-3xl shrink-0', p.highlight ? 'text-bronze-light' : 'text-encre']}>{l.total}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8 max-w-prose bg-creme rounded-sm p-6 border-l-2 border-bronze" data-reveal>
      <p class="text-sm font-light text-encre leading-relaxed">
        La part <strong class="font-medium">« vente » (sortie) est toujours de 20 %</strong>. Entrée et vente
        <strong class="font-medium"> se cumulent</strong> : si vous rentrez un mandat <em>et</em> le vendez vous-même,
        vous percevez les deux. Pourcentages calculés sur les honoraires HT encaissés.
      </p>
      <p class="mt-4 pt-4 border-t border-pierre-200 text-sm font-light text-pierre-600 leading-relaxed">
        <strong class="font-medium text-encre">Ces taux concernent les agents hors agence physique</strong>,
        c'est-à-dire hors bureaux de Biarritz et de Bordeaux, dont les conditions sont spécifiques.
      </p>
    </div>
  </Section>

  <!-- Cooptation -->
  <Section bg="encre" spacing="lg">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div data-reveal>
        <SectionHeading eyebrow="Au-delà des commissions" title="La cooptation : votre réseau valorisé" light={true} />
        <p class="mt-6 text-pierre-200 font-light leading-relaxed max-w-prose">
          Votre réseau devient une source de revenus complémentaire : recommandez une nouvelle recrue
          et soyez récompensé sur ses premières ventes.
        </p>
      </div>
      <div class="bg-encre-800/50 border border-pierre-600/30 rounded-sm p-8" data-reveal>
        <p class="display text-5xl text-bronze-light">+5 %</p>
        <div class="filet my-6"></div>
        <h3 class="text-lg font-light text-blanc">Sur les 3 premières ventes de votre recrue</h3>
        <p class="mt-2 text-sm font-light text-pierre-200 leading-relaxed">
          5 % sur les honoraires HT encaissés (déduction faite des éventuels apports d'affaires),
          dans la limite d'un forfait de <strong class="text-blanc">3 000 € TTC par vente</strong>.
        </p>
      </div>
    </div>
  </Section>

  <!-- Exemples chiffrés -->
  <Section bg="sable" spacing="lg">
    <SectionHeading
      eyebrow="Exemple concret"
      title="Pour une vente générant 40 000 € d'honoraires"
      intro="Selon votre rôle sur le mandat et votre palier, voici ce que vous percevez (hors cooptation)."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {exemples.map((e, i) => (
        <div class="bg-blanc rounded-sm p-7 border border-pierre-200" data-reveal style={`transition-delay:${i * 80}ms`}>
          <h3 class="text-base font-medium text-encre leading-snug min-h-[3rem]">{e.titre}</h3>
          <div class="filet my-5"></div>
          <p class="text-sm font-light text-pierre-600 leading-relaxed">{e.detail}</p>
          <p class="mt-5 display text-3xl text-bronze-dark">{e.commission}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-xs text-pierre-500 font-light max-w-prose">
      * Exemple pédagogique sur une base de 40 000 € HT d'honoraires d'agence. Les montants réels
      dépendent du prix de vente et des honoraires de chaque transaction.
    </p>
  </Section>

  <!-- Avantages du statut -->
  <Section bg="blanc" spacing="lg">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div data-reveal>
        <SectionHeading eyebrow="Statut indépendant" title="Les avantages de l'indépendance, sans la solitude" />
      </div>
      <ul class="space-y-5" data-reveal>
        {[
          ['Revenus non plafonnés', 'Vous percevez une part élevée des honoraires que vous générez, sans limite.'],
          ['Liberté d’organisation', 'Vous gérez votre temps, votre secteur et votre développement.'],
          ['Pas de charges de structure salariale', 'Un modèle plus léger qu’un poste salarié classique.'],
          ['Accompagnement inclus', 'Outils, formation et appui juridique fournis par Prestant.'],
        ].map(([t, d]) => (
          <li class="flex gap-4">
            <span class="text-bronze text-xl leading-none mt-1">—</span>
            <div><p class="font-medium text-encre">{t}</p><p class="text-sm font-light text-pierre-600 mt-1">{d}</p></div>
          </li>
        ))}
      </ul>
    </div>
    <div class="mt-12"><Button href="/offres-emploi" variant="primary">Voir les offres</Button></div>
  </Section>

  <!-- FAQ -->
  <Section bg="creme" spacing="lg">
    <div class="max-w-3xl mx-auto">
      <SectionHeading eyebrow="Questions fréquentes" title="La rémunération en clair" align="center" />
      <div class="mt-12"><Faq items={faq} /></div>
    </div>
  </Section>

  <CtaContact />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Faq from '../components/blocks/Faq.astro';
import CtaContact from '../components/blocks/CtaContact.astro';
import Button from '../components/ui/Button.astro';
import { faqSchema, breadcrumbSchema } from '../data/schema';

// Modèle de commissionnement Prestant (% des honoraires d'agence).
const commissions = [
  { label: 'Rentrée — mandat simple', taux: '30 %', note: "Vous obtenez le mandat simple" },
  { label: 'Rentrée — mandat exclusif', taux: '40 %', note: "Vous obtenez le mandat exclusif" },
  { label: 'Vente', taux: '20 %', note: "Vous vendez le bien (mandat simple ou exclusif)" },
];

// Exemple sur une vente générant 40 000 € d'honoraires d'agence.
const exemples = [
  { titre: 'Vous rentrez ET vendez un mandat exclusif', detail: '40 % (rentrée) + 20 % (vente) = 60 % des honoraires', commission: '24 000 €' },
  { titre: 'Vous rentrez un mandat exclusif (vendu par un collègue)', detail: '40 % des honoraires', commission: '16 000 €' },
  { titre: 'Vous vendez le mandat d’un collègue', detail: '20 % des honoraires', commission: '8 000 €' },
];

const faq = [
  { question: 'Comment suis-je rémunéré ?', reponse: "Vous percevez un pourcentage des honoraires d'agence : 30 % pour la rentrée d'un mandat simple, 40 % pour la rentrée d'un mandat exclusif, et 20 % pour la vente d'un bien (mandat simple ou exclusif). Rentrée et vente se cumulent : rentrer un mandat exclusif et le vendre vous-même représente 60 % des honoraires." },
  { question: "En quoi consiste la prime de 15 000 € ?", reponse: "Dès que vous dépassez 100 000 € de chiffre d'affaires sur l'exercice en cours, Prestant vous verse une prime de 15 000 € en bonus, en plus de vos commissions." },
  { question: 'Comment fonctionne la cooptation ?', reponse: "Pour chaque agent qui rejoint l'équipe via votre réseau, vous touchez 5 % supplémentaires sur les 3 premières ventes de cette nouvelle recrue. Votre réseau devient une source de revenus complémentaire." },
  { question: 'Y a-t-il un plafond de rémunération ?', reponse: "Non. Au statut d'agent commercial indépendant, vos revenus ne sont pas plafonnés : ils dépendent du nombre de mandats que vous rentrez et vendez, et de votre montée en puissance." },
  { question: 'Quand mes commissions sont-elles versées ?', reponse: "Votre commission est versée une fois la vente finalisée chez le notaire (acte authentique) et les honoraires encaissés par l'agence." },
];

const breadcrumb = breadcrumbSchema([
  { nom: 'Accueil', url: '/' },
  { nom: 'Rémunération', url: '/remuneration' },
]);
---
<BaseLayout
  title="Rémunération d'un agent commercial immobilier indépendant"
  description="Découvrez la rémunération d'un agent commercial indépendant Prestant : 30 % sur les mandats simples, 40 % sur les exclusifs, 20 % à la vente, prime de 15 000 € et cooptation. Sans plafond."
  ogImage="og-remuneration.jpg"
  schemas={[faqSchema(faq), breadcrumb]}
>
  <Section bg="sable" spacing="md" class="pt-32 sm:pt-36">
    <nav aria-label="Fil d'Ariane" class="text-xs tracking-wide text-pierre-500 mb-8">
      <a href="/" class="hover:text-bronze">Accueil</a> <span class="mx-2">/</span> <span class="text-encre">Rémunération</span>
    </nav>
    <SectionHeading
      eyebrow="Rémunération"
      title="Une rémunération transparente et non plafonnée"
      intro="Chez Prestant, vous êtes rémunéré à chaque étape — de la rentrée du mandat à la vente — avec un commissionnement clair, des primes et la cooptation. Sans plafond."
    />
  </Section>

  <!-- Le principe : commissions -->
  <Section bg="blanc" spacing="lg">
    <SectionHeading eyebrow="Le commissionnement" title="Payé à chaque étape, sur chaque mandat" />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {commissions.map((c, i) => (
        <div class="bg-sable rounded-sm p-8 border border-transparent hover:border-bronze/40 transition-all duration-300" data-reveal style={`transition-delay:${i * 80}ms`}>
          <p class="eyebrow">{c.label}</p>
          <p class="mt-6 display text-5xl text-encre">{c.taux}</p>
          <p class="mt-1 text-xs uppercase tracking-widest text-bronze">des honoraires d'agence</p>
          <div class="filet my-6"></div>
          <p class="text-sm font-light text-pierre-600">{c.note}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 max-w-prose bg-creme rounded-sm p-6 border-l-2 border-bronze" data-reveal>
      <p class="text-sm font-light text-encre leading-relaxed">
        <strong class="font-medium">Rentrée et vente se cumulent.</strong> Un mandat exclusif que
        vous rentrez <em>et</em> vendez vous-même représente <strong class="font-medium text-bronze-dark">40 % + 20 % = 60 %</strong>
        des honoraires d'agence.
      </p>
    </div>
  </Section>

  <!-- Bonus & cooptation -->
  <Section bg="encre" spacing="lg">
    <SectionHeading eyebrow="Au-delà des commissions" title="Primes & cooptation" light={true} />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="bg-encre-800/50 border border-pierre-600/30 rounded-sm p-8" data-reveal>
        <p class="display text-5xl text-bronze-light">+15 000 €</p>
        <div class="filet my-6"></div>
        <h3 class="text-lg font-light text-blanc">Prime de performance</h3>
        <p class="mt-2 text-sm font-light text-pierre-200 leading-relaxed">
          Dès <strong class="text-blanc">100 000 € de chiffre d'affaires</strong> sur l'exercice en cours,
          Prestant vous verse 15 000 € de prime, en plus de vos commissions.
        </p>
      </div>
      <div class="bg-encre-800/50 border border-pierre-600/30 rounded-sm p-8" data-reveal style="transition-delay:80ms">
        <p class="display text-5xl text-bronze-light">+5 %</p>
        <div class="filet my-6"></div>
        <h3 class="text-lg font-light text-blanc">Cooptation</h3>
        <p class="mt-2 text-sm font-light text-pierre-200 leading-relaxed">
          Pour chaque agent qui rejoint l'équipe via votre réseau, vous touchez 5 % sur ses
          <strong class="text-blanc">3 premières ventes</strong>. Votre réseau devient un revenu complémentaire.
        </p>
      </div>
    </div>
  </Section>

  <!-- Exemples chiffrés -->
  <Section bg="sable" spacing="lg">
    <SectionHeading
      eyebrow="Exemple concret"
      title="Pour une vente générant 40 000 € d'honoraires"
      intro="Selon votre rôle sur le mandat, voici ce que vous percevez (hors primes et cooptation)."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {exemples.map((e, i) => (
        <div class="bg-blanc rounded-sm p-7 border border-pierre-200" data-reveal style={`transition-delay:${i * 80}ms`}>
          <h3 class="text-base font-medium text-encre leading-snug min-h-[3rem]">{e.titre}</h3>
          <div class="filet my-5"></div>
          <p class="text-sm font-light text-pierre-600 leading-relaxed">{e.detail}</p>
          <p class="mt-5 display text-3xl text-bronze-dark">{e.commission}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-xs text-pierre-500 font-light max-w-prose">
      * Exemple pédagogique sur une base de 40 000 € d'honoraires d'agence. Les montants réels
      dépendent du prix de vente et des honoraires de chaque transaction.
    </p>
  </Section>

  <!-- Avantages du statut -->
  <Section bg="blanc" spacing="lg">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div data-reveal>
        <SectionHeading eyebrow="Statut indépendant" title="Les avantages de l'indépendance, sans la solitude" />
      </div>
      <ul class="space-y-5" data-reveal>
        {[
          ['Revenus non plafonnés', 'Vous percevez une part élevée des honoraires que vous générez, sans limite.'],
          ['Liberté d’organisation', 'Vous gérez votre temps, votre secteur et votre développement.'],
          ['Pas de charges de structure salariale', 'Un modèle plus léger qu’un poste salarié classique.'],
          ['Accompagnement inclus', 'Outils, formation et appui juridique fournis par Prestant.'],
        ].map(([t, d]) => (
          <li class="flex gap-4">
            <span class="text-bronze text-xl leading-none mt-1">—</span>
            <div><p class="font-medium text-encre">{t}</p><p class="text-sm font-light text-pierre-600 mt-1">{d}</p></div>
          </li>
        ))}
      </ul>
    </div>
    <div class="mt-12"><Button href="/offres-emploi" variant="primary">Voir les offres</Button></div>
  </Section>

  <!-- FAQ -->
  <Section bg="creme" spacing="lg">
    <div class="max-w-3xl mx-auto">
      <SectionHeading eyebrow="Questions fréquentes" title="La rémunération en clair" align="center" />
      <div class="mt-12"><Faq items={faq} /></div>
    </div>
  </Section>

  <CtaContact />
</BaseLayout>

---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CtaContact from '../components/blocks/CtaContact.astro';
import LiteYouTube from '../components/media/LiteYouTube.astro';
import { breadcrumbSchema } from '../data/schema';
import outilsImg from '../assets/photos/lifestyle-2.jpg';

const outils = [
  { titre: 'CRM immobilier avancé', texte: "Pilotez vos contacts, vos biens et vos transactions depuis un outil pensé pour la performance et le suivi client." },
  { titre: 'Diffusion premium multi-portails', texte: "Vos annonces mises en valeur sur les portails de référence et nos canaux propriétaires, avec une présentation haut de gamme." },
  { titre: 'Marketing & supports premium', texte: "Books de présentation, identité visuelle soignée, photo/vidéo : des supports dignes des biens d'exception." },
  { titre: 'IA & prospection digitale', texte: "Des méthodes et outils d'intelligence artificielle pour prospecter, qualifier et gagner du temps au quotidien." },
  { titre: 'Stratégies off-market', texte: "Accédez à un savoir-faire de mise en relation confidentielle, prisé sur le marché du prestige." },
  { titre: 'Accompagnement juridique', texte: "Un appui sur les aspects réglementaires et contractuels, pour exercer sereinement." },
];

const parcours = [
  { etape: '01', titre: 'Intégration', texte: "Découverte de la marque, des outils et des méthodes Prestant. Mise en place de votre environnement de travail." },
  { etape: '02', titre: 'Formation terrain', texte: "Estimation, prospection, négociation, mise en valeur des biens : une formation orientée pratique et performance." },
  { etape: '03', titre: 'Accompagnement', texte: "Un référent dédié, des points réguliers et un collectif à taille humaine pour progresser." },
  { etape: '04', titre: 'Montée en puissance', texte: "Développement de votre portefeuille et de votre notoriété, avec un suivi continu de vos résultats." },
];

const breadcrumb = breadcrumbSchema([
  { nom: 'Accueil', url: '/' },
  { nom: 'Outils & formation', url: '/outils-formation' },
]);
---
<BaseLayout
  title="Outils & formation de l'agent immobilier — accompagnement Prestant"
  description="Découvrez l'accompagnement Prestant : CRM, marketing premium, IA, stratégies off-market, parcours de formation et suivi continu pour réussir comme agent immobilier de prestige."
  ogImage="og-outils.jpg"
  schemas={[breadcrumb]}
>
  <Section bg="sable" spacing="md" class="pt-32 sm:pt-36">
    <nav aria-label="Fil d'Ariane" class="text-xs tracking-wide text-pierre-500 mb-8">
      <a href="/" class="hover:text-bronze">Accueil</a> <span class="mx-2">/</span> <span class="text-encre">Outils & formation</span>
    </nav>
    <SectionHeading
      as="h1"
      eyebrow="Accompagnement"
      title="Des outils premium et une formation qui font la différence"
      intro="Réussir dans l'immobilier de prestige ne s'improvise pas. Prestant met à votre disposition les outils, les méthodes et l'accompagnement nécessaires, du premier jour à votre pleine autonomie."
    />
  </Section>

  <!-- Outils -->
  <Section bg="blanc" spacing="lg">
    <SectionHeading eyebrow="Les outils" title="Tout pour capter et vendre les plus beaux biens" />
    <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {outils.map((o, i) => (
        <div data-reveal style={`transition-delay:${i * 60}ms`}>
          <div class="filet mb-4"></div>
          <h3 class="text-lg font-medium text-encre tracking-wide">{o.titre}</h3>
          <p class="mt-3 text-sm font-light leading-relaxed text-pierre-600">{o.texte}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Parcours de formation -->
  <Section bg="encre" spacing="lg">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:items-start">
      <div data-reveal>
        <SectionHeading eyebrow="Le parcours" title="Un accompagnement structuré, étape par étape" light={true} />
        <p class="mt-6 text-pierre-200 font-light leading-relaxed max-w-prose">
          Que vous soyez confirmé ou en reconversion, notre parcours vous amène progressivement
          vers l'autonomie et la performance.
        </p>
      </div>
      <ol class="space-y-8">
        {parcours.map((p, i) => (
          <li class="flex gap-6" data-reveal style={`transition-delay:${i * 60}ms`}>
            <span class="display text-3xl text-bronze-light shrink-0 w-12">{p.etape}</span>
            <div class="border-l border-pierre-600/30 pl-6">
              <h3 class="text-lg font-light text-blanc">{p.titre}</h3>
              <p class="mt-2 text-sm font-light text-pierre-200 leading-relaxed">{p.texte}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- Image immersive -->
  <Section bg="sable" spacing="lg">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <Image src={outilsImg} alt="Univers de travail Prestant" widths={[600, 1000]} sizes="(min-width:1024px) 50vw, 100vw"
        class="rounded-sm w-full object-cover aspect-[4/3]" loading="lazy" data-reveal />
      <div data-reveal>
        <SectionHeading eyebrow="Un collectif à taille humaine" title="Vous n'êtes jamais seul" />
        <p class="mt-6 text-pierre-600 font-light leading-relaxed max-w-prose">
          Au-delà des outils, c'est l'esprit Prestant qui fait la différence : un réseau à taille
          humaine où chaque agent est identifié, valorisé et soutenu. On avance ensemble, on partage
          les bonnes pratiques, et on cultive l'exigence du beau et du bien fait.
        </p>
      </div>
    </div>
  </Section>

  <!-- Vidéos : outils & formation expliqués -->
  <Section bg="creme" spacing="lg">
    <SectionHeading
      eyebrow="En vidéo"
      title="L'accompagnement Prestant, expliqué"
      intro="Outils, méthodes et formation des nouvelles recrues : Benoît et Sandy détaillent ce qui vous fait réussir."
    />
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <figure data-reveal>
        <LiteYouTube id="s5NB-GKpino" title="Les outils et accompagnements pour réussir" />
        <figcaption class="mt-4 text-sm font-light text-pierre-600">Les outils et accompagnements innovants pour aider les agents à réussir.</figcaption>
      </figure>
      <figure data-reveal style="transition-delay:80ms">
        <LiteYouTube id="SDBsMrzeHGA" title="La formation des nouvelles recrues" />
        <figcaption class="mt-4 text-sm font-light text-pierre-600">Les formations et l'accompagnement interne proposés aux nouvelles recrues.</figcaption>
      </figure>
    </div>
  </Section>

  <CtaContact />
</BaseLayout>

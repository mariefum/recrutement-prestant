---
import '../styles/global.css';
import { site, contact } from '../data/site';
import { organizationSchema } from '../data/schema';
const contactEmail = contact.email;
import BaseHead from '../components/seo/BaseHead.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileContactBar from '../components/layout/MobileContactBar.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** Schéma(s) JSON-LD additionnels propres à la page */
  schemas?: (Record<string, unknown> | Record<string, unknown>[])[];
  /** Hero sombre plein écran : header transparent au départ */
  darkHero?: boolean;
}
const { title, description, ogImage, noindex, schemas = [], darkHero = false } = Astro.props;
---
<!doctype html>
<html lang={site.langue}>
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} noindex={noindex} />
    <JsonLd schema={organizationSchema} />
    {schemas.map((s) => <JsonLd schema={s} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:z-[60] focus:top-3 focus:left-3 focus:bg-encre focus:text-blanc focus:px-4 focus:py-2 focus:rounded-sm">
      Aller au contenu
    </a>
    <Header darkHero={darkHero} />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileContactBar />
    <!-- padding bas pour ne pas masquer le contenu derrière la barre mobile -->
    <div class="lg:hidden h-16" aria-hidden="true"></div>

    <script>
      // Apparition douce au scroll (respecte prefers-reduced-motion via CSS)
      const els = document.querySelectorAll('[data-reveal]');
      if (els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>

    <script define:vars={{ contactEmail }}>
      // Soumission des formulaires par mailto : ouvre le client mail de
      // l'utilisateur avec un message pré-rempli adressé à Sandy.
      const LABELS = {
        nom: 'Nom et prénom', email: 'Email', telephone: 'Téléphone',
        secteur: 'Secteur géographique', experience: 'Expérience',
        poste: 'Poste visé', message: 'Message',
      };
      document.querySelectorAll('[data-mailto-form]').forEach((form) => {
        const status = form.querySelector('[data-form-status]');
        const setStatus = (msg, color) => {
          if (status) { status.textContent = msg; status.style.color = color; }
        };
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          // Honeypot anti-spam
          if (form.querySelector('[name="_gotcha"]')?.value) return;
          if (!form.checkValidity()) { form.reportValidity(); return; }

          const fd = new FormData(form);
          const subject = fd.get('_sujet') || 'Contact — site Prestant';
          let body = '';
          for (const [key, value] of fd.entries()) {
            if (['_sujet', '_gotcha', 'consentement', 'cv'].includes(key)) continue;
            if (!value) continue;
            body += `${LABELS[key] || key} : ${value}\n`;
          }
          // Le mailto ne peut pas joindre de fichier : on invite à le faire.
          if (form.dataset.mailtoForm === 'candidature') {
            body += `\n— Merci de joindre votre CV en pièce jointe de cet email. —\n`;
          }
          const href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          window.location.href = href;
          setStatus('Votre logiciel de messagerie va s’ouvrir avec votre message pré-rempli. Il ne reste qu’à l’envoyer.', '#A67C52');
        });
      });
    </script>
  </body>
</html>

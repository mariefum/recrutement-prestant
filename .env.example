# =============================================================
#  Variables d'environnement — à définir dans Vercel
#  (Project Settings → Environment Variables)
# =============================================================

# Clé API Resend (envoi des emails de formulaire). https://resend.com
RESEND_API_KEY=

# Expéditeur vérifié sur Resend (domaine prestant.com idéalement)
# Format : "Recrutement Prestant <recrutement@prestant.com>"
RESEND_FROM=

# Adresse d'intake de l'ATS Between : crée automatiquement la fiche candidat.
# (À récupérer dans Between — souvent une adresse type jobs+xxxx@between.com)
BETWEEN_INTAKE_EMAIL=

# Copie interne des candidatures / messages
CONTACT_EMAIL=sandy.miranda@prestant.com

# --- Authentification du back-office CMS (/admin) ---
# Identifiants de l'application OAuth GitHub (voir DEPLOIEMENT.md).
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
